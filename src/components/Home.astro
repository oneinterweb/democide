---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

import { copy } from '../translations';

const { lang } = Astro.props as { lang: 'en' | 'bg' };
const t = copy[lang];
---
<Layout lang={lang} title={t.title} description={t.intro}>
  <Header lang={lang} />
  <main id="main">
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="eyebrow"><span class="dot"></span>{t.eyebrow}</p>
        <h1>{t.heading}<em>{t.headingAccent}</em></h1>
        <p class="intro">{t.intro}</p>
        <div class="actions"><a class="button primary" href="https://www.hawaii.edu/powerkills/welcome.html">{t.visit} <span aria-hidden="true">↗</span></a><a class="text-link" href="#about">{t.learn} <span aria-hidden="true">↓</span></a></div>
      </div>
      <aside class="hero-art" aria-hidden="true"><div class="art-top">{t.artTop} <span>01 / 02</span></div><div class="art-title">{t.artTitle}<br /><i>{t.artMiddle}</i><br />{t.artLast}<span>.</span></div><div class="art-rule"></div><div class="art-bottom"><span>{t.artLeft}</span><span>{t.artRight}</span></div><div class="art-circle"></div></aside>
    </section>
    <section class="statement" id="about"><div class="wrap statement-grid"><p class="section-number">01 / {t.aboutLabel}</p><div><h2>{t.aboutTitle}</h2><p>{t.aboutText}</p></div></div></section>
    <section class="path wrap"><div class="section-heading"><div><p class="eyebrow">02 / {t.nextLabel}</p><h2>{t.nextTitle}</h2></div><p>{t.nextIntro}</p></div><div class="steps"><article><span>01</span><h3>{t.step1Title}</h3><p>{t.step1Text}</p></article><article><span>02</span><h3>{t.step2Title}</h3><p>{t.step2Text}</p></article><article><span>03</span><h3>{t.step3Title}</h3><p>{t.step3Text}</p></article></div></section>
    <section class="source wrap"><div><p class="eyebrow">03 / {t.sourceLabel}</p><h2>{t.sourceTitle}</h2><p>{t.sourceText}</p></div><a class="button light" href="https://www.hawaii.edu/powerkills/welcome.html">{t.sourceButton} ↗</a></section>
  </main>
  <Footer lang={lang} />
</Layout>

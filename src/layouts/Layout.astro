---
import '../styles/global.css';
const { lang, title, description } = Astro.props;
---
<!doctype html><html lang={lang}><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><title>{title}</title></head><body><a class="skip" href="#main">{lang === 'bg' ? 'Към съдържанието' : 'Skip to content'}</a><slot /></body></html>
